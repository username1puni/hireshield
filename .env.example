# Copy to .env and fill in. Never commit the real .env.

# Database
DB_USERNAME=hireshield
DB_PASSWORD=change-me

# JWT signing key, at least 32 characters (e.g. openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY_MINUTES=1440

# First admin account, created on startup if it does not exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Only needed when the frontend runs on a different origin (e.g. Vite dev server)
CORS_ORIGINS=http://localhost:5173

# Optional: friendly explanations from an LLM (any OpenAI-compatible API, e.g. Groq or OpenAI).
# The app works without it and falls back to template explanations.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai
LLM_MODEL=llama-3.3-70b-versatile

# Optional: Google Safe Browsing API key for link checks
SAFE_BROWSING_API_KEY=
